cameras:
- backend: libav
  cameraName: 前门摄像头
  decoder: auto
  enabled: true
  onvifProfile: main
  password: ''
  renderer: video
  url: onvif://192.168.1.100:2020
  username: admin
- backend: libav
  cameraName: 客厅
  decoder: auto
  enabled: true
  onvifProfile: auto
  password: ''
  renderer: video
  url: rtsp://192.168.1.101:554/live/main
  username: ''
homeAssistant:
  actions:
  - domain: switch
    entityId: switch.main_power
    name: 全屋总控
    service: toggle
    slideToTurnOff: true
  - domain: cooker
    entityId: sensor.smart_cooker_status
    name: 电饭煲
    service: start_cooking
  - domain: script
    entityId: script.timed_cook_runner
    name: 智能蒸煮
    service: toggle
    isSteamer: true
    # 配套 Home Assistant 端完整配置包见: examples/homeassistant/packages/kitchen_steamer.yaml
    # 可直接放置到 HA 的 packages/ 目录下使用，开箱即用。
    # 可选高级定制参数（系统支持从 HA 自动智能嗅探；若其他用户的 HA 实体命名不同，亦可显式指定）：
    # socketEntity: switch.dining_socket      # 通电控制插座/开关实体
    # timerEntity: timer.steamer_timer        # 倒计时器实体
    # modeEntity: input_select.steamer_mode   # 模式选择器实体（自动向 UI 同步 HA 中配置的模式列表）
    # stopService: script.steamer_stop        # 停机脚本服务
  - domain: washer
    entityId: sensor.smart_washer_status
    name: 滚筒洗衣机
    service: turn_on
  - domain: switch
    entityId: switch.living_room_light
    name: 客厅灯
    service: toggle
  - domain: switch
    entityId: switch.dining_room_light
    name: 餐厅灯
    service: toggle
  - domain: switch
    entityId: switch.washroom_light
    name: 洗漱台
    service: toggle
  - domain: switch
    entityId: switch.corridor_light
    name: 走廊灯
    service: toggle
  - domain: switch
    entityId: switch.bedroom_light
    name: 北卧室灯
    service: toggle
  - domain: switch
    entityId: switch.bedside_light
    name: 床头灯
    service: toggle
  - domain: switch
    entityId: switch.bedroom_socket
    name: 主卧插座
    service: toggle
  - domain: switch
    entityId: switch.dining_socket
    name: 餐桌插座
    service: toggle
  baseUrl: http://192.168.1.10:8123
  enabled: true
  token: ''
ui:
  # 手机横屏模式下，视频卡片下方留出空间的辅助扩展卡片模式：
  # 可选值：
  #   - "camera" 或 "A": 多摄像头通道快速切换与监控工具栏（默认）
  #   - "scene" 或 "B": 全屋安防与快捷场景模式（回家/离家布防/睡眠/会客）
  #   - "security" 或 "C": 全屋安防状态速览（智能门锁/门窗闭合/照明/实时功耗）
  video_bottom_card_mode: camera
platform:
  chip: RK3568
  height: 480
  reducedEffects: false
  renderMode: eglfs
  width: 800
screenPower:
  blankEnd: '07:00'
  blankStart: '23:00'
  enabled: true
  idleTimeoutSeconds: 180
  panelConfig: auto
  temporaryWakeMinutes: 5
weather:
  areaId: '101010100'
  city: 北京
  enabled: true
  provider: china_weather
  refreshMinutes: 30
wifi:
  enabled: true
  interface: wlan0
  password: ''
  ssid: ''
xiaozhi:
  applicationName: xiaozhi_linux_100ask
  applicationVersion: 1.0.0
  authToken: ''
  autoListenOnConnect: false
  autoStartAudio: true
  boardName: rk3506_home_gui
  boardType: rk3506_linux_board
  configPath: /etc/xiaozhi.cfg
  enabled: false
  language: zh-CN
  otaUrl: https://api.tenclass.net/xiaozhi/ota/
  soundAppPath: xiaozhi_sound_app
  userAgent: weidongshan1
  wakeGpioActiveLow: false
  wakeGpioDebounceMs: 80
  wakeGpioLine: -1
  websocketHost: api.tenclass.net
  websocketPath: /xiaozhi/v1/
  websocketPort: 443
